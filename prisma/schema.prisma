// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RentalAlert {
  id            String   @id @default(cuid())
  roomType      String
  actionLabel   String
  deviceUserId  Int
  updatedBy     String
  source        String
  messageStatus String
  alertDate     String
  alertTime     String
  createdAt     DateTime @default(now())
}

model AppSettings {
  id                 String   @id @default(cuid())
  mansionName         String   @default("Mansion Rental Alert System")
  ownerName           String   @default("Owner")
  ownerWhatsAppNumber String   @default("")
  caretakerName       String   @default("Caretaker")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DeviceState {
  id                  String   @id @default(cuid())
  status              String   @default("online")
  lastSyncAt          String?
  deviceMode          String   @default("MOCK")
  deviceModel         String   @default("Not configured")
  deviceIp            String?
  devicePort          Int      @default(4370)
  deviceLocation      String?
  realDeviceEnabled   Boolean  @default(false)
  lastHeartbeatAt     DateTime?
  connectionStatus    String   @default("MOCK_OFFLINE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Worker {
  id            String               @id @default(cuid())
  name          String
  phone         String?
  personType    String               @default("ATTENDANCE_AND_ROOM")
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  fingerMappings WorkerFingerMapping[]
  attendanceLogs WorkerAttendance[]
}

model WorkerFingerMapping {
  id           String   @id @default(cuid())
  workerId     String
  worker       Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  deviceUserId Int      @unique
  actionType   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkerAttendance {
  id             String   @id @default(cuid())
  workerId       String
  worker         Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  deviceUserId   Int
  status         String
  attendanceDate String
  attendanceTime String
  source         String
  createdAt      DateTime @default(now())
}

model MessageLog {
  id                   String   @id @default(cuid())
  messageType          String
  recipient            String
  templateName         String
  templateVariables    Json
  messageBody          String
  status               String
  provider             String
  relatedRentalAlertId String?
  relatedAttendanceId  String?
  errorMessage         String?
  sentAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
